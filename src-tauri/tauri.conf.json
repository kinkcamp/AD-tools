{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/tauri/schema.json",
  "productName": "AD域控助手",
  "version": "1.0.0",
  "identifier": "com.adtools.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AD 域控助手",
        "width": 1200,
        "height": 750,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}